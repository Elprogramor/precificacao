[hidden] { display: none !important; }
:root{
  color-scheme: dark;

  --bg: #0b1220;
  --panel: rgba(255,255,255,0.06);
  --panel-2: rgba(255,255,255,0.08);
  --line: rgba(255,255,255,0.12);
  --text: rgba(255,255,255,0.92);
  --muted: rgba(255,255,255,0.70);
  --muted-2: rgba(255,255,255,0.55);
  --shadow: 0 18px 55px rgba(0,0,0,0.38);
  --radius: 18px;

  --primary: #32d7ff;
  --primary-2: #7c4dff;
  --danger: #ff4d6d;
  --ok: #2ee59d;

  --ring: 0 0 0 4px rgba(50, 215, 255, 0.22);
  --ring-danger: 0 0 0 4px rgba(255, 77, 109, 0.22);
  --ring-ok: 0 0 0 4px rgba(46, 229, 157, 0.20);

  --err: rgba(255,77,109,0.95);
  --err-bg: rgba(255,77,109,0.10);
}

*{ box-sizing: border-box; }
html, body{ height: 100%; }
body{
  margin: 0;
  font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
  color: var(--text);
  background:
    radial-gradient(900px 420px at 20% -10%, rgba(50,215,255,0.20), transparent 60%),
    radial-gradient(800px 420px at 85% 0%, rgba(124,77,255,0.18), transparent 55%),
    radial-gradient(700px 420px at 50% 120%, rgba(46,229,157,0.10), transparent 55%),
    var(--bg);
  line-height: 1.35;
}

a{ color: inherit; }

.skip-link{
  position: absolute;
  left: -9999px;
  top: 12px;
  padding: 10px 14px;
  background: rgba(255,255,255,0.12);
  border: 1px solid var(--line);
  border-radius: 12px;
  color: var(--text);
  text-decoration: none;
  z-index: 50;
}
.skip-link:focus{
  left: 12px;
  outline: none;
  box-shadow: var(--ring);
}

.topbar{
  position: sticky;
  top: 0;
  z-index: 40;
  backdrop-filter: blur(14px);
  background: rgba(11,18,32,0.65);
  border-bottom: 1px solid var(--line);
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))){
  .topbar{
    backdrop-filter: none;
    background: rgba(11,18,32,0.92);
  }
}

.topbar__inner{
  max-width: 1180px;
  margin: 0 auto;
  padding: 16px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}
.brand{
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}
.brand__mark{
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(50,215,255,0.26), rgba(124,77,255,0.20));
  border: 1px solid rgba(255,255,255,0.12);
  box-shadow: 0 10px 30px rgba(0,0,0,0.25);
  font-weight: 800;
}
.brand__text{
  display: grid;
  gap: 2px;
  min-width: 0;
}
.brand__text strong{
  letter-spacing: 0.2px;
  font-size: 14px;
}
.brand__text span{
  font-size: 12px;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topbar__actions{
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.wrap{
  max-width: 1180px;
  margin: 0 auto;
  padding: 22px 18px 34px;
}

.grid{
  display: grid;
  gap: 18px;
  grid-template-columns: 1.06fr 0.94fr;
}

.card{
  background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.05));
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
}
.card__head{
  padding: 18px 18px 8px;
}
.card__head h1,
.card__head h2{
  margin: 0;
  font-size: 16px;
  letter-spacing: 0.2px;
}
.card__head p{
  margin: 10px 0 0;
}

.muted{ color: var(--muted); }
.help{ color: var(--muted-2); font-size: 12px; margin-top: 6px; display: block; }
.error{
  color: var(--err);
  font-size: 12px;
  margin-top: 6px;
  display: block;
  min-height: 16px;
}
.field--error input,
.field--error select{
  border-color: rgba(255,77,109,0.55);
  background: rgba(255,77,109,0.06);
}
.field--error input:focus-visible,
.field--error select:focus-visible{
  box-shadow: var(--ring-danger);
}

.note{
  margin: 14px 18px 18px;
  padding: 12px 12px;
  border-radius: 14px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.10);
  color: var(--muted);
}

.form{
  padding: 10px 18px 16px;
  display: grid;
  gap: 12px;
}
.form--compact{
  padding-top: 8px;
  padding-bottom: 12px;
}
.form__row{
  display: grid;
  gap: 12px;
  grid-template-columns: 1fr 1fr;
}
.form__row:last-child{
  grid-template-columns: auto auto;
  justify-content: start;
  gap: 10px;
}
.field{
  display: grid;
  gap: 8px;
  min-width: 0;
}
label{
  font-size: 12px;
  color: var(--muted);
  letter-spacing: 0.2px;
}
input, select{
  width: 100%;
  background: rgba(10,16,28,0.55);
  border: 1px solid rgba(255,255,255,0.14);
  border-radius: 14px;
  padding: 12px 12px;
  color: var(--text);
  outline: none;
  transition: transform .12s ease, border-color .12s ease, box-shadow .12s ease, background .12s ease;
}
input::placeholder{ color: rgba(255,255,255,0.40); }
input:focus, select:focus{
  border-color: rgba(50,215,255,0.48);
  box-shadow: var(--ring);
  background: rgba(10,16,28,0.72);
}
input:focus-visible, select:focus-visible{
  border-color: rgba(50,215,255,0.48);
  box-shadow: var(--ring);
  background: rgba(10,16,28,0.72);
}
input:active, select:active{ transform: translateY(1px); }

.btn{
  appearance: none;
  border: 1px solid rgba(255,255,255,0.14);
  background: rgba(255,255,255,0.06);
  color: var(--text);
  border-radius: 14px;
  padding: 11px 14px;
  font-weight: 700;
  letter-spacing: 0.2px;
  cursor: pointer;
  transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease, background .12s ease, opacity .12s ease;
  user-select: none;
}
.btn:hover{
  background: rgba(255,255,255,0.09);
  border-color: rgba(255,255,255,0.20);
}
.btn:active{ transform: translateY(1px); }
.btn:focus{ outline: none; }
.btn:focus-visible{ outline: none; box-shadow: var(--ring); }

.btn--primary{
  border-color: rgba(50,215,255,0.40);
  background: linear-gradient(135deg, rgba(50,215,255,0.22), rgba(124,77,255,0.20));
}
.btn--primary:hover{
  border-color: rgba(50,215,255,0.60);
  background: linear-gradient(135deg, rgba(50,215,255,0.28), rgba(124,77,255,0.24));
}

.btn--ghost{
  background: rgba(255,255,255,0.04);
}

.btn--danger{
  border-color: rgba(255,77,109,0.40);
  background: rgba(255,77,109,0.10);
}
.btn--danger:focus-visible{ box-shadow: var(--ring-danger); }
.btn--danger:hover{
  border-color: rgba(255,77,109,0.55);
  background: rgba(255,77,109,0.14);
}

.file-btn{
  position: relative;
  overflow: hidden;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.file-btn input{
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
}

.table-wrap{
  padding: 0 18px 18px;
  overflow: auto;
  -webkit-overflow-scrolling: touch;
}
.table-wrap:focus{
  outline: none;
  box-shadow: var(--ring);
  border-radius: 14px;
}
.table{
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  min-width: 720px;
  background: rgba(10,16,28,0.35);
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: 16px;
  overflow: hidden;
}
.table caption{
  text-align: left;
  padding: 10px 12px;
  color: var(--muted-2);
  font-size: 12px;
}
.table thead th{
  text-align: left;
  font-size: 12px;
  letter-spacing: 0.2px;
  color: var(--muted);
  padding: 12px 12px;
  border-bottom: 1px solid rgba(255,255,255,0.10);
  background: rgba(255,255,255,0.04);
  position: sticky;
  top: 0;
  z-index: 1;
}
.table td{
  padding: 12px 12px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
  vertical-align: middle;
}
.table tr:last-child td{ border-bottom: none; }
.table--soft{ min-width: 620px; }

.right{ text-align: right; }

.cell-title{
  display: grid;
  gap: 4px;
}
.cell-title strong{
  font-size: 13px;
}
.cell-title span{
  font-size: 12px;
}

.pill{
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.12);
  background: rgba(255,255,255,0.06);
  font-weight: 800;
  font-size: 12px;
  white-space: nowrap;
}

.row-actions{
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.icon-btn{
  width: 38px;
  height: 38px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.14);
  background: rgba(255,255,255,0.05);
  color: var(--text);
  cursor: pointer;
  transition: transform .12s ease, border-color .12s ease, background .12s ease, box-shadow .12s ease;
}
.icon-btn:hover{
  background: rgba(255,255,255,0.08);
  border-color: rgba(255,255,255,0.22);
}
.icon-btn:active{ transform: translateY(1px); }
.icon-btn:focus{ outline: none; }
.icon-btn:focus-visible{ outline: none; box-shadow: var(--ring); }
.icon-btn--danger{
  border-color: rgba(255,77,109,0.35);
  background: rgba(255,77,109,0.08);
}
.icon-btn--danger:hover{
  border-color: rgba(255,77,109,0.55);
  background: rgba(255,77,109,0.12);
}
.icon-btn--danger:focus-visible{ box-shadow: var(--ring-danger); }

.icon-btn--ok{
  border-color: rgba(46,229,157,0.35);
  background: rgba(46,229,157,0.08);
}
.icon-btn--ok:hover{
  border-color: rgba(46,229,157,0.55);
  background: rgba(46,229,157,0.12);
}
.icon-btn--ok:focus-visible{ box-shadow: var(--ring-ok); }

.edit-input{
  padding: 10px 10px;
  border-radius: 12px;
}

.empty td{ padding: 0; }
.empty__box{
  padding: 16px 14px;
  display: grid;
  gap: 6px;
  text-align: left;
}
.empty__box strong{ font-size: 13px; }
.empty__box span{ font-size: 12px; color: var(--muted); }

.sep{
  border: none;
  height: 1px;
  background: rgba(255,255,255,0.10);
  margin: 8px 18px;
}

.summary{
  padding: 6px 0 6px;
}
.summary__grid{
  display: grid;
  gap: 12px;
  padding: 0 18px;
  grid-template-columns: 1fr 1fr;
}
.kpi{
  padding: 14px 14px;
  border-radius: 16px;
  border: 1px solid rgba(255,255,255,0.12);
  background: rgba(255,255,255,0.05);
  display: grid;
  gap: 6px;
}
.kpi__label{
  font-size: 12px;
  color: var(--muted);
}
.kpi__value{
  font-size: 20px;
  letter-spacing: 0.2px;
}
.kpi__sub{
  font-size: 12px;
  color: var(--muted-2);
}

.pricing{
  padding: 12px 18px 4px;
  display: grid;
  gap: 12px;
}
.pricing__row{
  display: grid;
  gap: 12px;
  grid-template-columns: 1fr 1fr 1fr 1fr;
}
.pricing__result{
  display: grid;
  gap: 12px;
  grid-template-columns: 1fr 1fr;
}
.pricebox{
  padding: 14px 14px;
  border-radius: 16px;
  border: 1px solid rgba(50,215,255,0.20);
  background: linear-gradient(135deg, rgba(50,215,255,0.14), rgba(124,77,255,0.12));
  display: grid;
  gap: 6px;
}
.pricebox--soft{
  border-color: rgba(255,255,255,0.12);
  background: rgba(255,255,255,0.05);
}
.pricebox--real{
  border-color: rgba(46,229,157,0.22);
  background: linear-gradient(135deg, rgba(46,229,157,0.14), rgba(50,215,255,0.08));
}
.pricebox__label{
  font-size: 12px;
  color: var(--muted);
}
.pricebox__value{
  font-size: 22px;
  letter-spacing: 0.2px;
}
.pricebox__sub{
  font-size: 12px;
  color: var(--muted-2);
}

/* MODELOS */
.models{
  padding: 10px 0 0;
}
.models__head{
  padding: 10px 18px 0;
}
.models__title{
  margin: 0;
  font-size: 14px;
  letter-spacing: 0.2px;
}
.models__sub{
  margin: 8px 0 0;
  font-size: 12px;
}
.models__bar{
  padding: 10px 18px 8px;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 12px;
  align-items: end;
}
.models__actions{
  display: grid;
  gap: 10px;
  grid-auto-flow: column;
  justify-content: end;
  align-items: center;
}

/* DISTRIBUIÇÃO */
.breakdown{
  padding: 8px 18px 0;
  display: grid;
  gap: 10px;
}
.breakdown__head{
  display: grid;
  gap: 6px;
}
.breakdown__title{
  margin: 0;
  font-size: 14px;
  letter-spacing: 0.2px;
}
.breakdown__sub{
  margin: 0;
  font-size: 12px;
}
.breakdown__list{
  display: grid;
  gap: 10px;
}
.breakdown__empty{
  padding: 12px 12px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.10);
  background: rgba(255,255,255,0.04);
}
.b-item{
  display: grid;
  gap: 8px;
  padding: 12px 12px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.10);
  background: rgba(255,255,255,0.04);
}
.b-item__row{
  display: flex;
  gap: 10px;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
}
.b-item__name{
  font-weight: 800;
  font-size: 13px;
}
.b-item__meta{
  font-size: 12px;
  color: var(--muted);
}
.b-bar{
  height: 10px;
  border-radius: 999px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.10);
  overflow: hidden;
}
.b-bar__fill{
  height: 100%;
  width: 0%;
  border-radius: 999px;
  background: linear-gradient(90deg, rgba(50,215,255,0.70), rgba(46,229,157,0.60));
}

/* FOOTER */
.footer{
  border-top: 1px solid rgba(255,255,255,0.10);
  padding: 18px;
  background: rgba(11,18,32,0.55);
}
.footer__inner{
  max-width: 1180px;
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
  justify-content: space-between;
}

/* MODAL */
.modal{
  position: fixed;
  inset: 0;
  z-index: 80;
  display: grid;
  place-items: center;
  padding: 18px;
}
.modal__backdrop{
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.55);
}
.modal__dialog{
  position: relative;
  width: min(720px, 100%);
  border-radius: 18px;
  border: 1px solid rgba(255,255,255,0.14);
  background: rgba(11,18,32,0.92);
  box-shadow: 0 28px 90px rgba(0,0,0,0.55);
  overflow: hidden;
  outline: none;
}
.modal__head{
  padding: 14px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border-bottom: 1px solid rgba(255,255,255,0.10);
  background: rgba(255,255,255,0.04);
}
.modal__title{
  margin: 0;
  font-size: 14px;
  letter-spacing: 0.2px;
}
.modal__close{
  width: 38px;
  height: 38px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.14);
  background: rgba(255,255,255,0.06);
  color: var(--text);
  cursor: pointer;
}
.modal__close:hover{
  background: rgba(255,255,255,0.10);
}
.modal__close:focus-visible{
  outline: none;
  box-shadow: var(--ring);
}
.modal__body{
  padding: 14px 16px 4px;
  display: grid;
  gap: 12px;
}
.modal__actions{
  padding: 12px 16px 16px;
  display: flex;
  gap: 10px;
  justify-content: flex-end;
  flex-wrap: wrap;
}

/* Ajuda dentro do modal */
.help-grid{
  display: grid;
  gap: 12px;
}
.help-step{
  padding: 12px 12px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.10);
  background: rgba(255,255,255,0.04);
  display: grid;
  gap: 6px;
}
.help-step strong{
  font-size: 13px;
}
.help-step span{
  font-size: 12px;
  color: var(--muted);
}

/* REDUZ MOVIMENTO */
@media (prefers-reduced-motion: reduce){
  *{
    scroll-behavior: auto !important;
    transition: none !important;
    animation: none !important;
  }
}

@media (max-width: 980px){
  .grid{ grid-template-columns: 1fr; }
  .table{ min-width: 680px; }
  .pricing__row{ grid-template-columns: 1fr 1fr; }
  .models__bar{ grid-template-columns: 1fr; }
  .models__actions{ justify-content: start; grid-auto-flow: row; }
}

@media (max-width: 560px){
  .topbar__inner{ padding: 14px 14px; }
  .wrap{ padding: 18px 14px 28px; }
  .card__head{ padding: 16px 14px 8px; }
  .form{ padding: 10px 14px 14px; }
  .table-wrap{ padding: 0 14px 14px; }
  .summary__grid{ padding: 0 14px; grid-template-columns: 1fr; }
  .pricing{ padding: 12px 14px 4px; }
  .pricing__row{ grid-template-columns: 1fr; }
  .pricing__result{ grid-template-columns: 1fr; }
  .breakdown{ padding: 8px 14px 0; }
  .models__head{ padding: 10px 14px 0; }
  .models__bar{ padding: 10px 14px 8px; }
  .btn{ width: 100%; }
  .form__row:last-child{ grid-template-columns: 1fr; }
}
